load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("@rules_python//python/uv:lock.bzl", "lock")
load("//private:configured_tool.bzl", "configured_tool")

# `bazel run //djlint:requirements.update` rewrites requirements.txt from
# requirements.in.
lock(
    name = "requirements",
    srcs = ["requirements.in"],
    out = "requirements.txt",
)

py_console_script_binary(
    name = "djlint_bin",
    # No implicit __init__.py files, which rules_python warns about.
    legacy_create_init = 0,
    pkg = "@bazel_style_pip//djlint",
    python_version = "3.14",
    script = "djlint",
)

# djlint with .djlintrc from here. --prefer-configuration makes its settings
# win over a .djlintrc or pyproject.toml of the repository's own, which djlint
# otherwise prefers; .editorconfig only fills in settings that .djlintrc
# leaves unset.
configured_tool(
    name = "djlint",
    args_before_config = [
        "--prefer-configuration",
        "--configuration",
    ],
    # djlint exits 1 when --reformat has changed a file.
    changed_exit_flag = "--reformat",
    config = ".djlintrc",
    tool = ":djlint_bin",
    visibility = ["//visibility:public"],
)
