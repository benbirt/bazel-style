<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>Fixture</title>
<style>body{margin:0}</style></head>
<body><main><h1>A plain page</h1><p>Some text that is long enough to show where lines are wrapped by the formatter, if they are wrapped at all.</p>
<ul><li>One</li><li>Two</li></ul></main>
<script>const items=document.querySelectorAll("li");for(const item of items){item.title=item.textContent}</script></body></html>
