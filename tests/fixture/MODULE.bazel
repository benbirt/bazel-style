"""A consumer of bazel_style with a file of every language it formats."""

bazel_dep(name = "bazel_style", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "bazel_style",
    path = "../..",
)

# For tools/tofu, which formats .tf and .tfvars files with tofu fmt.
bazel_dep(name = "rules_tofu", version = "0.6.0", dev_dependency = True)
